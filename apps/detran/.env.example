# ── App DETRAN-CE ───────────────────────────────────────────
# Servidor Node (API local)
PORT=3334

# Origens permitidas no CORS (separadas por vírgula) — front do Vite
CORS_ORIGIN=http://localhost:3001

# Front (Vite): sobrescreve a URL da API
VITE_API_URL=http://localhost:3334/api

# Caminho do Chrome/Chromium usado pelo Puppeteer (opcional)
PUPPETEER_EXECUTABLE_PATH=

# ── Automação semanal (relatório por e-mail) ─────────────────
# Desligada por padrão. Ligue só depois de preencher tudo abaixo.
DETRAN_AUTOMACAO_ATIVA=false
# Sexta-feira às 07:00 (minuto hora dia mês dia-da-semana)
DETRAN_AUTOMACAO_CRON=0 7 * * 5
DETRAN_AUTOMACAO_TZ=America/Fortaleza
# 1 = uma consulta por vez (mais seguro com o portal) | 2 = mais rápido
DETRAN_AUTOMACAO_CONCORRENCIA=1

# Chave do cofre que cifra a lista de veículos (AES-256-GCM).
# Gere com: npm run cofre:gerar-chave   — e guarde FORA do repositório.
# Perder a chave = perder a lista salva (é preciso importá-la de novo).
DETRAN_COFRE_CHAVE=
# Alternativa à chave (mín. 16 caracteres). Prefira a chave aleatória.
DETRAN_COFRE_SENHA=
# Só durante a rotação: chave antiga, aceita apenas para ler (regrava com a nova).
DETRAN_COFRE_CHAVE_ANTERIOR=

# SMTP (587 + STARTTLS, ou 465 com SMTP_SECURE=true)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Use um remetente do domínio autenticado (SPF/DKIM/DMARC) para não cair em spam
EMAIL_FROM="FORCE Relatórios <relatorios@seudominio.com.br>"
# Destinatários separados por vírgula
EMAIL_TO=
EMAIL_CC=
# Avisos de falha (padrão: os mesmos de EMAIL_TO)
EMAIL_ALERTA=
# Logo e GIF embutidos no e-mail. Deixe false se aparecerem como anexo ou se o e-mail cair em spam.
EMAIL_IMAGENS=false

# --- Memória ---
# Minutos sem nenhuma aba aberta até o Chromium (maior consumo de RAM) fechar sozinho.
# Próxima consulta/PDF reabre sozinho. 0 = nunca fecha.
BROWSER_OCIOSO_MIN=2
