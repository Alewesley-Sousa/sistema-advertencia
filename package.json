{
  "name": "sistema-advertencia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:wialon": "npm run dev -w @force/wialon",
    "dev:detran": "npm run dev -w @force/detran",
    "build": "npm run build --workspaces --if-present",
    "build:wialon": "npm run build -w @force/wialon",
    "build:detran": "npm run build -w @force/detran",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "oxlint apps packages"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2"
  }
}
